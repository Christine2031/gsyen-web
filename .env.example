# Moonshot Kimi
MOONSHOT_API_KEY=your_moonshot_api_key_here

# DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Supabase (HalfSphere shared instance)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
VITE_GSYEN_API_URL=https://your-gsyen-api.run.app

# Server-side aliases used by /api/chat authorization.
# They may contain the same public URL/anon key values as the VITE_ variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
