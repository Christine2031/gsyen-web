HOST=127.0.0.1
PORT=18085
NODE_ENV=production
MAIL_DOMAIN=gsyen.com
MAIL_HOSTNAME=mail.gsyen.com
# Generate outside Git with `openssl rand -base64 32 | tr '+/' '-_' | tr -d '='`;
# never reuse or commit it.
MAIL_MIRROR_TOKEN=__MAIL_MIRROR_TOKEN__
MAIL_MIRROR_MAX_BYTES=5242880
MAIL_MIRROR_MAX_CONCURRENT_DELIVERIES=4
MAIL_MIRROR_RECEIPT_DIR=/srv/gsyen/data/mail-mirror/receipts
MAIL_MIRROR_MIN_FREE_BYTES=1073741824
MAIL_MIRROR_LEASE_MS=120000
MAIL_MIRROR_SMTP_TIMEOUT_MS=15000
MAIL_MIRROR_HEALTH_SMTP_TIMEOUT_MS=3000
# Keep false until the RFC 7352 guard is installed and the two-delivery
# verification in deploy/aliyun/stalwart/README.md passes against this server.
STALWART_DUPLICATE_GUARD_VERIFIED=false
STALWART_SMTP_HOST=127.0.0.1
STALWART_SMTP_PORT=25
