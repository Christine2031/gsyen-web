[Unit]
Description=Encrypted GSYEN file and export backup
After=local-fs.target

[Service]
Type=oneshot
Slice=gsyen.slice
UMask=0077
ExecStart=/usr/local/libexec/gsyen-aliyun/backup-space.sh gsyen /etc/gsyen-aliyun/backup/gsyen.conf --apply
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/gsyen/backups /srv/gsyen/data
ReadOnlyPaths=/srv/gsyen/apps /srv/gsyen/config
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
