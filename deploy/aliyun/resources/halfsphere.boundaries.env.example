# HalfSphere values must not equal GSYEN's production database user, bucket,
# ACR namespace, SLS project or RAM role.
BUSINESS_SPACE=halfsphere
LINUX_USER=halfsphere
SERVICE_PREFIX=halfsphere-
ROOT_PATH=/srv/halfsphere
PORT_MIN=18180
PORT_MAX=18189
RDS_DATABASE=halfsphere
RDS_SCHEMA=halfsphere
RDS_APP_USER=halfsphere_app
OSS_ISOLATION_MODE=dedicated_bucket
OSS_BUCKET=__REQUIRED_UNIQUE__
OSS_PREFIX=halfsphere/
ACR_NAMESPACE=halfsphere
SLS_PROJECT=__REQUIRED_UNIQUE__
RAM_ROLE=__REQUIRED_UNIQUE__
