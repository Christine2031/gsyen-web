# This is a non-secret topology assertion, not proof that either ECS exists.
# shared_ecs intentionally cannot pass while both applications request isolated
# instance RAM roles: Alibaba Cloud permits only one instance role per ECS.
TOPOLOGY=__REQUIRED_shared_ecs_OR_separate_ecs__
GSYEN_ECS_ID=__REQUIRED_EXPLICIT_INSTANCE_ID__
HALFSPHERE_ECS_ID=__REQUIRED_EXPLICIT_INSTANCE_ID__
