# Production must fail closed on a missing, relative, future-dated, or stale dataset.
GSYEN_MODEL_DATA_MODE=production
GSYEN_MODEL_DATA_PATH=/srv/gsyen/data/gsyen-model/datasets/current/transactions.csv
GSYEN_MODEL_MAX_DATA_AGE_DAYS=7
GSYEN_MODEL_DATA_MAX_BYTES=268435456
GSYEN_MODEL_DATA_SHA256=__REQUIRED_64_HEX_SHA256__

# Browser clients must call the authenticated GSYEN API adapter, not this service.
GSYEN_MODEL_CORS_ORIGINS=

# Bound native math-library concurrency inside the model unit.
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
