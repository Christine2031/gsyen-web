# Runtime-only values. NEXT_PUBLIC_* values are embedded at build time and must
# be supplied by the CI build from protected secrets, not by this file.
HOSTNAME=127.0.0.1
PORT=18180
NODE_ENV=production
NEXT_PUBLIC_SUPABASE_URL=__REQUIRED_AT_BUILD_TIME__
NEXT_PUBLIC_SUPABASE_ANON_KEY=__REQUIRED_AT_BUILD_TIME__
NEXT_PUBLIC_API_URL=https://api.halfsphere.example.invalid
APP_BASE_URL=https://halfsphere.example.invalid
SUPABASE_SERVICE_ROLE_KEY=__SECRET_REQUIRED__
HALFSPHERE_ENCRYPTION_KEY=__SECRET_REQUIRED__
RESEND_API_KEY=__SECRET_REQUIRED__
CRON_SECRET=__SECRET_REQUIRED__
